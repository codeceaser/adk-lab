# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is git-ignored. Never commit real credentials.
#
# ADK walks up from the agent folder (adk_lab/) to find `.env`, so a single
# `.env` at the repository root covers the whole lab.

# Which backend google-genai talks to.
#   0 = Gemini API (API key)
#   1 = Vertex AI / enterprise (Application Default Credentials)
# NOTE: in google-adk 2.6.3 this variable replaces the older
# GOOGLE_GENAI_USE_VERTEXAI, which still works but logs a deprecation warning.
GOOGLE_GENAI_USE_ENTERPRISE=0

# --- Required when GOOGLE_GENAI_USE_ENTERPRISE=0 ---
# Create a key at https://aistudio.google.com/apikey and paste it here.
GOOGLE_API_KEY=

# --- Required instead when GOOGLE_GENAI_USE_ENTERPRISE=1 ---
# Also run: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
